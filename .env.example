MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?appName=Cluster0
PORT=4000
# Chuỗi ngẫu nhiên >= 32 ký tự: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
ADMIN_USER=admin
# Tuỳ chọn: hash scrypt để ghi đè mật khẩu admin mặc định (xem middleware/auth.js)
ADMIN_PASS_HASH=
# Đặt = 1 nếu chạy sau reverse proxy (nginx, Render, Heroku...)
TRUST_PROXY=
