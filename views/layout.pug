doctype html
html(lang="vi")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width,initial-scale=1")
    meta(name="csrf-token" content=csrfToken)
    title #{title || 'Admin Panel'} — Key Manager
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    style.
      :root {
        --bg: #f5f7fb;
        --surface: #ffffff;
        --surface2: #f8fafc;
        --border: #e5e9f2;
        --border2: #d5dbe7;
        --primary: #4f46e5;
        --primary-h: #4338ca;
        --primary-l: #eef2ff;
        --success: #059669;
        --success-l: #ecfdf5;
        --danger: #dc2626;
        --danger-l: #fef2f2;
        --warning: #d97706;
        --warning-l: #fffbeb;
        --text: #0f172a;
        --text2: #475569;
        --text3: #94a3b8;
        --radius: 14px;
        --shadow-sm: 0 1px 2px rgba(15,23,42,.05);
        --shadow: 0 1px 3px rgba(15,23,42,.06), 0 8px 24px -12px rgba(15,23,42,.12);
        --shadow-lg: 0 24px 60px -12px rgba(15,23,42,.28);
        --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      * { box-sizing:border-box; margin:0; padding:0; }
      body { font-family:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif; background:var(--bg); color:var(--text); min-height:100vh; font-size:14px; -webkit-font-smoothing:antialiased; }
      a { color:var(--primary); text-decoration:none; }
      button { font-family:inherit; }

      /* Topbar */
      .topbar { background:rgba(255,255,255,.85); backdrop-filter:saturate(180%) blur(12px); border-bottom:1px solid var(--border); height:64px; position:sticky; top:0; z-index:50; }
      .topbar-inner { max-width:1200px; margin:0 auto; height:100%; display:flex; align-items:center; gap:14px; padding:0 24px; }
      .brand { display:flex; align-items:center; gap:11px; font-weight:700; font-size:15.5px; color:var(--text); letter-spacing:-.01em; }
      .brand-icon { width:36px; height:36px; border-radius:10px; display:grid; place-items:center; color:#fff; background:linear-gradient(135deg,#6366f1,#8b5cf6); box-shadow:0 6px 16px -6px rgba(99,102,241,.6); }
      .brand small { display:block; font-size:11.5px; font-weight:500; color:var(--text3); }
      .topbar-spacer { flex:1; }
      .user-chip { display:flex; align-items:center; gap:8px; padding:5px 12px 5px 5px; border:1px solid var(--border); border-radius:99px; font-size:13px; font-weight:500; color:var(--text2); background:var(--surface); }
      .user-chip .avatar { width:26px; height:26px; border-radius:50%; background:var(--primary-l); color:var(--primary); display:grid; place-items:center; font-size:12px; }

      /* Layout */
      .page { max-width:1200px; margin:0 auto; padding:32px 24px 64px; }
      .page-head { display:flex; align-items:flex-end; justify-content:space-between; gap:16px; margin-bottom:24px; flex-wrap:wrap; }
      .page-head h1 { font-size:24px; font-weight:800; letter-spacing:-.02em; }
      .page-head p { color:var(--text2); margin-top:4px; }

      /* Cards */
      .card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); box-shadow:var(--shadow); overflow:hidden; }
      .toolbar { padding:16px 20px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
      .toolbar h2 { font-size:15px; font-weight:700; margin-right:auto; }

      /* Buttons */
      .btn { display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:9px 16px; border-radius:10px; font-size:13.5px; font-weight:600; cursor:pointer; border:1px solid transparent; transition:all .15s; white-space:nowrap; line-height:1.2; }
      .btn:disabled { opacity:.6; cursor:not-allowed; }
      .btn-primary { background:var(--primary); color:#fff; box-shadow:0 4px 12px -4px rgba(79,70,229,.5); }
      .btn-primary:hover:not(:disabled) { background:var(--primary-h); }
      .btn-danger { background:var(--danger); color:#fff; }
      .btn-danger:hover { background:#b91c1c; }
      .btn-ghost { background:var(--surface); color:var(--text2); border-color:var(--border2); }
      .btn-ghost:hover { background:var(--surface2); color:var(--text); }
      .btn-sm { padding:6px 12px; font-size:12.5px; border-radius:8px; }
      .icon-btn { width:32px; height:32px; display:inline-grid; place-items:center; border-radius:8px; border:1px solid transparent; background:transparent; color:var(--text3); cursor:pointer; transition:all .15s; font-size:13px; }
      .icon-btn:hover { background:var(--surface2); border-color:var(--border); color:var(--text); }
      .icon-btn.danger:hover { background:var(--danger-l); border-color:#fecaca; color:var(--danger); }
      .icon-btn.success:hover { background:var(--success-l); border-color:#a7f3d0; color:var(--success); }
      .icon-btn.primary:hover { background:var(--primary-l); border-color:#c7d2fe; color:var(--primary); }

      /* Form */
      .field { margin-bottom:16px; }
      .field:last-child { margin-bottom:0; }
      label { display:block; font-size:12.5px; font-weight:600; color:var(--text2); margin-bottom:6px; }
      .input, select.input { width:100%; padding:10px 12px; border:1px solid var(--border2); border-radius:10px; background:var(--surface); color:var(--text); font-size:14px; font-family:inherit; outline:none; transition:border-color .15s, box-shadow .15s; }
      .input:focus { border-color:var(--primary); box-shadow:0 0 0 4px rgba(79,70,229,.12); }
      .input:disabled { background:var(--surface2); color:var(--text3); }
      .input.mono { font-family:var(--mono); letter-spacing:.06em; }
      .input-icon { position:relative; }
      .input-icon i { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--text3); font-size:13px; pointer-events:none; }
      .input-icon .input { padding-left:36px; }
      .row { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
      .hint { font-size:12px; color:var(--text3); margin-top:6px; }
      .check { display:inline-flex; align-items:center; gap:8px; font-size:13px; font-weight:500; color:var(--text2); cursor:pointer; margin:0; }
      .check input { width:16px; height:16px; accent-color:var(--primary); }
      .chips { display:flex; gap:6px; flex-wrap:wrap; margin-top:8px; }
      .chip { padding:4px 10px; border-radius:99px; border:1px solid var(--border2); background:var(--surface); font-size:12px; font-weight:600; color:var(--text2); cursor:pointer; }
      .chip:hover { border-color:var(--primary); color:var(--primary); background:var(--primary-l); }
      .chip:disabled { opacity:.5; cursor:not-allowed; }

      /* Table */
      .table-wrap { overflow-x:auto; }
      table { width:100%; border-collapse:collapse; }
      th { padding:11px 16px; font-size:11.5px; font-weight:600; color:var(--text3); text-transform:uppercase; letter-spacing:.05em; text-align:left; background:var(--surface2); border-bottom:1px solid var(--border); white-space:nowrap; }
      td { padding:13px 16px; font-size:13.5px; color:var(--text); border-bottom:1px solid var(--border); vertical-align:middle; }
      tbody tr:last-child td { border-bottom:none; }
      tbody tr { transition:background .12s; }
      tbody tr:hover td { background:#fafbff; }
      .muted { color:var(--text3); }
      .owner-name { font-weight:600; }
      .owner-phone { font-size:12.5px; color:var(--text2); margin-top:2px; }
      .key-code { display:inline-flex; align-items:center; gap:6px; font-family:var(--mono); font-size:12.5px; font-weight:600; letter-spacing:.06em; color:var(--primary); background:var(--primary-l); padding:5px 6px 5px 10px; border-radius:8px; }
      .key-code button { border:none; background:transparent; color:#818cf8; cursor:pointer; width:22px; height:22px; border-radius:6px; font-size:11.5px; }
      .key-code button:hover { background:#e0e7ff; color:var(--primary); }
      .actions { display:flex; gap:2px; justify-content:flex-end; }
      .empty { text-align:center; padding:56px 20px; color:var(--text3); }
      .empty i { font-size:32px; margin-bottom:12px; opacity:.5; display:block; }

      /* Device meter */
      .meter { display:flex; align-items:center; gap:10px; }
      .meter-bar { width:56px; height:6px; border-radius:99px; background:#eef1f6; overflow:hidden; }
      .meter-bar span { display:block; height:100%; border-radius:99px; background:var(--primary); }
      .meter.full .meter-bar span { background:var(--danger); }
      .meter-text { font-size:12.5px; font-weight:600; color:var(--text2); min-width:30px; }
      .meter-link { border:none; background:none; color:var(--primary); font-size:12px; font-weight:600; cursor:pointer; padding:2px 4px; border-radius:6px; }
      .meter-link:hover { background:var(--primary-l); }

      /* Badges */
      .badge { display:inline-flex; align-items:center; gap:6px; padding:3px 10px; border-radius:99px; font-size:12px; font-weight:600; white-space:nowrap; }
      .badge::before { content:''; width:6px; height:6px; border-radius:50%; background:currentColor; }
      .badge.plain::before { display:none; }
      .badge-green { background:var(--success-l); color:var(--success); }
      .badge-red { background:var(--danger-l); color:var(--danger); }
      .badge-yellow { background:var(--warning-l); color:var(--warning); }
      .badge-gray { background:#f1f5f9; color:var(--text2); }
      .badge-blue { background:var(--primary-l); color:var(--primary); }

      /* Alert */
      .alert { padding:12px 16px; border-radius:12px; font-size:13.5px; margin-bottom:18px; display:flex; align-items:center; gap:10px; border:1px solid; }
      .alert-error { background:var(--danger-l); border-color:#fecaca; color:#b91c1c; }
      .alert-success { background:var(--success-l); border-color:#a7f3d0; color:#047857; }

      /* Modal */
      .modal-overlay { display:none; position:fixed; inset:0; background:rgba(15,23,42,.45); backdrop-filter:blur(3px); z-index:1000; align-items:center; justify-content:center; padding:16px; }
      .modal-overlay.open { display:flex; animation:fade .15s ease; }
      .modal { background:var(--surface); border-radius:18px; width:100%; max-width:540px; box-shadow:var(--shadow-lg); max-height:calc(100vh - 32px); overflow:auto; animation:pop .18s ease; }
      .modal-sm { max-width:420px; }
      .modal-head { display:flex; align-items:center; gap:12px; padding:22px 24px 0; }
      .modal-head .m-icon { width:40px; height:40px; border-radius:12px; display:grid; place-items:center; background:var(--primary-l); color:var(--primary); font-size:16px; flex-shrink:0; }
      .modal-head .m-icon.danger { background:var(--danger-l); color:var(--danger); }
      .modal-head h3 { font-size:17px; font-weight:700; letter-spacing:-.01em; }
      .modal-head p { font-size:13px; color:var(--text2); margin-top:2px; }
      .modal-head .icon-btn { margin-left:auto; align-self:flex-start; }
      .modal-body { padding:20px 24px; }
      .modal-footer { display:flex; gap:10px; justify-content:flex-end; padding:16px 24px; background:var(--surface2); border-top:1px solid var(--border); }
      @keyframes fade { from { opacity:0 } }
      @keyframes pop { from { opacity:0; transform:translateY(8px) scale(.98) } }

      /* Stats */
      .stats { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:24px; }
      .stat-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:18px 20px; box-shadow:var(--shadow-sm); display:flex; align-items:center; gap:14px; }
      .stat-icon { width:44px; height:44px; border-radius:12px; display:grid; place-items:center; font-size:17px; flex-shrink:0; }
      .stat-label { font-size:12.5px; font-weight:500; color:var(--text2); }
      .stat-value { font-size:26px; font-weight:800; letter-spacing:-.02em; margin-top:2px; line-height:1.1; }
      .s-primary .stat-icon { background:var(--primary-l); color:var(--primary); }
      .s-success .stat-icon { background:var(--success-l); color:var(--success); }
      .s-danger .stat-icon { background:var(--danger-l); color:var(--danger); }
      .s-warning .stat-icon { background:var(--warning-l); color:var(--warning); }

      /* Devices */
      .device-item { display:flex; align-items:center; gap:12px; padding:12px 0; border-bottom:1px solid var(--border); }
      .device-item:last-child { border-bottom:none; }
      .device-item > i { width:34px; height:34px; border-radius:10px; background:var(--surface2); border:1px solid var(--border); display:grid; place-items:center; color:var(--text2); flex-shrink:0; }
      .device-info { flex:1; min-width:0; }
      .device-id { font-family:var(--mono); font-size:12px; color:var(--text); word-break:break-all; }
      .device-date { font-size:12px; color:var(--text3); margin-top:2px; }

      /* Created key */
      .created-key { background:linear-gradient(135deg,#eef2ff,#f5f3ff); border:1px dashed #a5b4fc; border-radius:14px; padding:20px; text-align:center; }
      .created-key .lbl { font-size:11.5px; font-weight:600; color:var(--text2); text-transform:uppercase; letter-spacing:.08em; }
      .created-key .val { font-family:var(--mono); font-size:26px; font-weight:600; color:var(--primary); letter-spacing:.14em; margin-top:8px; word-break:break-all; }

      /* Toast */
      .toasts { position:fixed; bottom:20px; right:20px; z-index:3000; display:flex; flex-direction:column; gap:10px; }
      .toast { display:flex; align-items:center; gap:10px; background:var(--text); color:#fff; padding:12px 16px; border-radius:12px; font-size:13.5px; font-weight:500; box-shadow:var(--shadow-lg); animation:pop .2s ease; max-width:360px; }
      .toast.ok i { color:#34d399; }
      .toast.err i { color:#f87171; }

      @media (max-width:900px) { .stats { grid-template-columns:repeat(2,1fr); } }
      @media (max-width:560px) {
        .page { padding:20px 16px 48px; }
        .topbar-inner { padding:0 16px; }
        .stats { gap:10px; }
        .stat-card { padding:14px; gap:10px; }
        .stat-icon { width:36px; height:36px; font-size:14px; }
        .stat-value { font-size:21px; }
        .row { grid-template-columns:1fr; }
        .user-chip span { display:none; }
        .toolbar > * { flex:1 1 100%; }
      }

  body
    header.topbar
      .topbar-inner
        .brand
          .brand-icon
            i.fas.fa-key
          div
            | Key Manager
            small ATuPinProMax
        .topbar-spacer
        .user-chip
          .avatar
            i.fas.fa-user-shield
          span Admin
        form(method="POST" action="/admin/logout")
          input(type="hidden" name="_csrf" value=csrfToken)
          button.btn.btn-ghost.btn-sm(type="submit" title="Đăng xuất")
            i.fas.fa-arrow-right-from-bracket
            span Đăng xuất

    block content

    .toasts#toasts

    script(nonce=nonce).
      // Global helpers
      const CSRF = document.querySelector('meta[name="csrf-token"]').content;
      function closeModal(id) { document.getElementById(id).classList.remove('open'); }
      function openModal(id) { document.getElementById(id).classList.add('open'); }
      function toast(msg, ok = true) {
        const el = document.createElement('div');
        el.className = 'toast ' + (ok ? 'ok' : 'err');
        const ic = document.createElement('i');
        ic.className = 'fas ' + (ok ? 'fa-circle-check' : 'fa-circle-exclamation');
        el.append(ic, document.createTextNode(msg));
        document.getElementById('toasts').appendChild(el);
        setTimeout(() => el.remove(), 3500);
      }
      async function api(url, method = 'GET', body) {
        const opts = { method, headers: { 'X-CSRF-Token': CSRF } };
        if (body !== undefined) {
          opts.headers['Content-Type'] = 'application/json';
          opts.body = JSON.stringify(body);
        }
        try {
          const r = await fetch(url, opts);
          if (r.status === 401) { location.href = '/admin/login'; return { ok: false }; }
          return await r.json();
        } catch (e) {
          return { ok: false, message: 'Không kết nối được server' };
        }
      }
      // Đóng modal khi click nền hoặc nút [data-close]
      document.addEventListener('click', e => {
        if (e.target.classList.contains('modal-overlay')) e.target.classList.remove('open');
        const c = e.target.closest('[data-close]');
        if (c) closeModal(c.dataset.close);
      });
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape') document.querySelectorAll('.modal-overlay.open').forEach(m => m.classList.remove('open'));
      });

    block scripts
